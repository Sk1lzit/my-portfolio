generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ЮЗЕРЫ =====
model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String?
  name        String?
  avatar      String?
  role        String    @default("USER") // USER | ADMIN
  orders      Order[]
  messages    Message[]
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===== ЗАКАЗЫ =====
model Order {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname    String
  brief       String
  contacts    String
  price       Int
  deadline    DateTime
  status      String    @default("IN_PROGRESS")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// ===== СООБЩЕНИЯ =====
model Message {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAdmin   Boolean   @default(false)
  text        String
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ===== ОТЗЫВЫ =====
model Review {
  id          String    @id @default(cuid())
  clerkId     String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  avatar      String?
  rating      Int
  text        String
  approved    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([approved])
  @@index([userId])
}

// ===== ПРОЕКТЫ =====
model Project {
  id          String    @id @default(cuid())
  slug        String    @unique
  icon        String
  title       String
  tags        String[]
  images      String[]
  problem     String
  solution    String
  result      String
  published   Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===== ЗАМЕТКИ =====
model Note {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  tags        String[]
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}